# Copy to .env for local dev:  cp .env.example .env
# .env is gitignored - real secrets NEVER get committed. In the cloud, you set
# these as the host's environment variables / secrets, not in a file.

# Which environment this is. Affects nothing but /version and your own logic.
APP_ENV=development

# Set automatically by CI to the commit SHA that built the image. Leave as-is locally.
GIT_SHA=dev

# "offline" (default, no key needed) or "gemini" (needs the key below).
TLDR_MODEL=offline

# A SECRET. Only needed if TLDR_MODEL=gemini. Get one free at ai.google.dev.
# Leave blank to stay fully offline.
GEMINI_API_KEY=

# The port to listen on. Cloud hosts (e.g. Cloud Run) inject their own $PORT.
PORT=8000
